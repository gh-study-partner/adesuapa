# Copy these NAMES into Vercel -> Project -> Settings -> Environment Variables.
# Never put real values in this file, in index.html, or in GitHub.

# Admin dashboard login (set your own — do not leave the built-in default)
ADMIN_USER=
ADMIN_PASS=

# Random text, 32+ characters, used to sign login sessions
AUTH_SECRET=

# Database: added automatically when you connect Upstash Redis / Vercel KV in the Vercel dashboard
# (KV_REST_API_URL, KV_REST_API_TOKEN or the UPSTASH_REDIS_REST_* equivalents)

# Optional extras (leave out if you do not use them)
YOUTUBE_API_KEY=
GEMINI_API_KEY=
GOOGLE_CSE_ID=
